# ============================================
# 仓库根 .gitignore（防御层）
# ============================================
# 子目录各自的 .gitignore 已经覆盖：
#   server/.gitignore  → node_modules/、dist/、.env、*.log
#   client/.gitignore  → node_modules、dist、.env、.vite、.vscode/* 等
# 这里只兜底可能漏在根目录的杂物。

# 本地环境变量（万一有人复制到根目录）
.env
.env.local

# 杂项
.DS_Store
Thumbs.db
*.log
*.swp
*.bak

# 编辑器/IDE（子目录没盖到的部分）
.idea/
.vscode/
!.vscode/extensions.json

# 临时文件
tmp/
*.tmp

# ============================================
# 安全：SSH 私钥（绝不能 commit）
# ============================================
# Sealos DevBox 部署密钥
sealos-*.pem
sealos-*.pem.*
*.pem.run_ns-*
*.pem.run_*

# ============================================
# 构建产物 / 部署打包（不入库）
# ============================================
# zip / tar.gz 打包文件
*.zip
*.tar.gz
*.tgz

# 命名约定显式再列一遍（防止其它 glob 失效）
client-dist.*
server-dist.*
client.zip
server.zip
client-dist.zip
client-dist.tar.gz
server-dist.zip
server-dist.tar.gz