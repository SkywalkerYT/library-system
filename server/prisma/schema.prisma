// ============================================
// Library System — Prisma Schema
// 数据库：MySQL 8
//   - 本地：docker MySQL 容器
//   - 生产：Railway 自带 MySQL（PlanetScale 在国内不可用）
// 命名风格：snake_case 字段、PascalCase 模型
// ============================================

generator client {
  provider      = "prisma-client-js"
  // ★ Railway 默认是 Debian + OpenSSL 3，同时保留 native（本地开发）+ rhel-openssl-3 兜底
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  // ★ Railway MySQL 支持外键约束，但保留 relationMode = "prisma" 提升可移植性
  //   （未来切到 Neon / PlanetScale / TiDB 不用改 schema）
  //   代价：join 写法不能用 include on nullable relations，必须手写两段查询
  relationMode = "prisma"
}

enum BookStatus {
  AVAILABLE
  BORROWED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  displayName  String   @db.VarChar(50)
  isAdmin      Boolean  @default(false)        // ★ RBAC：手动 SQL 提权（受控、可审计）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isAdmin])   // 中间件二次校验（adminRouter 每次请求查 isAdmin）
}

model Book {
  id           Int        @id @default(autoincrement())
  title        String     @db.VarChar(50)
  author       String     @db.VarChar(30)
  category     String     @db.VarChar(20)
  status       BookStatus @default(AVAILABLE)
  summary      String?    @db.Text

  // ★ 借阅字段（新增）
  borrowerName   String?   @db.VarChar(30)
  borrowerPhone  String?   @db.VarChar(20)
  borrowedAt     DateTime?
  dueAt          DateTime?
  borrowerUserId Int?      // ★ 借阅人 ID（用于 admin 用户列表"当前借阅数"统计）

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ★ 社区图书馆：Book 是全社区共享的实体，无 userId 归属
  //   联合索引按 status / category 提升过滤性能
  @@index([status])
  @@index([category])
  @@index([borrowerUserId, status])   // 借阅数统计：WHERE borrowerUserId = ? AND status = ?
}
