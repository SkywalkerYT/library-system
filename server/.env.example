# ============================================
# Library System Backend — Environment Variables
# ============================================
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。
# 生产环境(Sealos DevBox)由 /home/devbox/server/.env 持有同名变量。

# ---------- Database ----------
# 本地开发：本地 MySQL(8.x,root 密码 root123,库名 mybook_db)
#   docker run -d --name lib-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=root123 -e MYSQL_DATABASE=mybook_db mysql:8
DATABASE_URL="mysql://root:root123@localhost:3306/mybook_db"

# 生产(Sealos DevBox)：用 Sealos 控制台「内部连接地址」,自己拼上库名
#   1) Sealos 控制台 → MySQL 服务 → 内部连接(格式 mysql://root:<PWD>@<HOST>.svc:3306)
#   2) 末尾拼上 /<DB_NAME>。**不带库名 Prisma 启动会报 P1001/P1017**
DATABASE_URL="mysql://root:<PASSWORD>@<HOST>.svc:3306/mybook_db"

# ---------- JWT ----------
# 至少 16 字节,生产必须重新生成：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="dev-secret-change-me-in-production-32bytes"

# ---------- CORS ----------
# 逗号分隔,不要带 / 后缀。本地 = Vite 默认端口；生产 = 前端 Sealos 公网域。
#   本地：  CLIENT_ORIGIN="http://localhost:5173"
#   生产：  CLIENT_ORIGIN="https://<your-app>.sealoshzh.site"
#
# 顺带说明：Sealos 部署里前端用 client/server.js 反代 /api → backend,
# 同源调用根本不会触发 CORS。这里写前端域是为了"将来拆公网直连"留口子。
CLIENT_ORIGIN="http://localhost:5173"

# ---------- Server ----------
# 本地默认 3000；Sealos 后端 DevBox 监听 3000 与 server.js 默认 BACKEND_URL 对齐
PORT=3000
NODE_ENV=development
