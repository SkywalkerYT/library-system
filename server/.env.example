# ============================================
# Library System Backend — Environment Variables
# ============================================
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。
# 生产环境由 Railway 注入同名变量（DATABASE_URL / JWT_SECRET / CLIENT_ORIGIN / PORT / NODE_ENV）。

# ---------- Database ----------
# 本地开发：本地 docker MySQL
#   docker run -d --name lib-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=root123 -e MYSQL_DATABASE=mybook_db mysql:8
DATABASE_URL="mysql://root:root123@localhost:3306/mybook_db"

# 生产：Railway 自带 MySQL（PlanetScale 替代方案）
#   1) Railway 项目页 → New → Database → MySQL
#   2) 切到新 MySQL 服务 → Variables → 复制 MYSQL_URL
#   3) 把它粘到 Web 服务 → Variables → DATABASE_URL（值完全一样）
#   4) 部署时 railway.json 的 startCommand 会跑 `npx prisma migrate deploy`，
#      现有的 20260729083039_init 迁移会自动 apply
# DATABASE_URL="mysql://root:<PASSWORD>@<HOST>:<PORT>/railway"

# ---------- JWT ----------
# 至少 32 字节随机串。生产必须重新生成：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="dev-secret-change-me-in-production-32bytes"

# ---------- CORS ----------
# 本地：Vite 默认端口
# 生产：Vercel 部署后的前端域名（不要带 / 后缀，多个用逗号分隔）
#   CLIENT_ORIGIN="https://library-system-xxx.vercel.app"
#
# 另外 app.ts 里**自动放行所有 *.vercel.app 子域**（覆盖 Vercel 生产域 +
# 每个 PR 的 preview 部署），所以 Vercel 子域不用写到 CLIENT_ORIGIN 里。
# 这里只填"非 vercel.app"的额外 origin（如自建域名）。
CLIENT_ORIGIN="http://localhost:5173"

# ---------- Server ----------
# Railway 会自动覆盖 PORT；本地默认 3000
PORT=3000
NODE_ENV=development
